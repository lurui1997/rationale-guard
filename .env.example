# FalkorDB connection.
# Free-tier FalkorDB Cloud accepts plaintext redis://. rediss:// (TLS) has been
# observed to hang on that tier, so both schemes are supported and neither is rewritten.
FALKORDB_URL=redis://localhost:6379
# Alternative to the URL (used only when FALKORDB_URL is empty):
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# OpenAI-compatible chat completions endpoint. DeepSeek is the default.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Provider model id sent on the wire. Never an internal tag (offline, heuristic, decision-extract-v1).
LLM_MODEL=deepseek-chat
# Other ids DeepSeek has published: deepseek-flash, deepseek-v4-pro

# Optional. Unauthenticated GitHub REST works at a lower rate limit.
GITHUB_TOKEN=

# Days without activity before rule R6 marks an author inactive.
STALE_INACTIVE_DAYS=90

# auto: offline judge when no API key, LLM judge when a key is set.
# offline and llm are explicit. A failed LLM call is never rewritten as an offline verdict.
GUARD_JUDGE=auto

# Public base URL of this app, used by the GitHub Action example.
# RATIONALE_API_URL=http://localhost:8000
